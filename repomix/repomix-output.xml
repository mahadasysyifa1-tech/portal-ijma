                        item.rules.some((r) => r.id.toLowerCase().includes(search.toLowerCase()))
                      )
                      .map((item, idx) => (
                        <div
                          key={item.key || idx}
                          className="p-3.5 rounded-xl border border-rose-200 bg-rose-50/30 space-y-2 shadow-2xs"
